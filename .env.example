# Configurações do Servidor AlexaAudio
PORT=3000

# URL Pública HTTPS (ex: Tailscale Funnel, ngrok, Cloudflare Tunnel)
# Esta URL precisa ser HTTPS com certificado SSL válido para a Alexa funcionar
PUBLIC_URL=https://seu-dominio.ts.net

# Porta do Servidor TCP Interno de Captura WASAPI
LOCAL_AUDIO_PORT=3001
